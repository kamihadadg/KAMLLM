# بارگذاری از پوشه backend (مسیر cwd): اینجا کار کن یا از ریشه repo از kamllm.cmd استفاده کن.

# Ollama API (HTTP)
OLLAMA_BASE_URL=http://127.0.0.1:11434

OLLAMA_CHAT_MODEL=qwen2.5-coder:7b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Dir for SQLite index (chunks.sqlite) — retained name CHROMA_PATH for compat
CHROMA_PATH=.chroma

# Chunking
CHUNK_CHAR_SIZE=1200
CHUNK_CHAR_OVERLAP=150

# Retrieval
TOP_K_CHUNKS=6

# --- HTTP API (برای فرانت جدا، مثلاً Next.js روی پورت 3000) ---
# KAMLLM_API_HOST=127.0.0.1
# KAMLLM_API_PORT=8765
# KAMLLM_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# اجرا: uvicorn kamllm.api_main:app --host 127.0.0.1 --port 8765
# یا:    python -m kamllm.api_main
# یا:    kamllm-api

# Workspace + auth (JWT, DB per user projects):
# JWT_SECRET=use-a-long-random-string-in-production
# JWT_EXPIRE_DAYS=30
# KAMLLM_DATA_DIR=data